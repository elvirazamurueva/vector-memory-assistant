# Шаблон переменных окружения.
# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env никогда не коммитится в git.

# --- GenAPI: embeddings и языковая модель ----------------------------------
GENAPI_API_KEY=<ваш ключ GenAPI>
# Базовый URL чата (OpenAI-совместимый). Можно указывать и полный путь
# .../v1/chat/completions — код сам отрежет лишний суффикс.
GENAPI_URL=https://proxy.gen-api.ru/v1

# Модель для получения embedding
EMBEDDING_MODEL=text-embedding-3-small

# Отдельный endpoint GenAPI для embeddings (нативный API генераций).
# У GenAPI embeddings НЕ на OpenAI-совместимом пути, а здесь.
EMBEDDINGS_URL=https://api.gen-api.ru/api/v1/networks/embeddings

# Языковая модель для ответов бота
CHAT_MODEL=<название модели, например gpt-4o-mini>

# --- Pinecone: векторное хранилище -----------------------------------------
PINECONE_API_KEY=<ваш ключ Pinecone>
PINECONE_INDEX_NAME=nemo

# Сетевой proxy ТОЛЬКО для Pinecone (независимая настройка).
# У Pinecone данные индекса лежат на отдельном домене, который из некоторых
# сетей недоступен напрямую — тогда укажите здесь тот же proxy, что и для
# Telegram, в формате user:pass@host:port.
# На Telegram и GenAPI эта настройка НЕ влияет. Пусто — работаем напрямую.
PINECONE_PROXY_URL=

# --- Telegram-бот -----------------------------------------------------------

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=<токен бота>

# СЕТЕВОЙ proxy для доступа к api.telegram.org (относится ТОЛЬКО к Telegram).
# GenAPI работает напрямую; у Pinecone своя отдельная настройка PINECONE_PROXY_URL.
#
# Основной формат:
# без схемы, вида user:pass@host:port (в коде к нему добавляется http://).
# Оставьте пустым, если proxy не нужен (например, бот запущен с VPS).
PROXY_URL=

# Запасной способ — детальные переменные (используются, только если PROXY_URL пуст).
# TELEGRAM_PROXY_TYPE: http, https, socks5 или socks4 (если пусто и задан host — http)
TELEGRAM_PROXY_TYPE=
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
